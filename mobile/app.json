{
  "expo": {
    "name": "Calmaria",
    "slug": "calmaria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calmaria",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F1F5F7",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "A Calmaria usa sua localização para mostrar os lugares perto e o lugar calmo mais próximo. Ela não é enviada a ninguém além da API da Calmaria."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3D5A73",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F5F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#14191F",
            "image": "./assets/images/splash-icon-escuro.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Calmaria usa sua localização para mostrar os lugares perto e o lugar calmo mais próximo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

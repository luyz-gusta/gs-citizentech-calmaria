# Segredos: nunca versionar. Cada pasta traz um .env.exemplo (na API, .env.example, o nome do guia de SOA) sem os segredos.
.env
.env.*
!.env.example
!.env.exemplo
*.pfx
*.pem
appsettings.Local.json

# .NET (api-dotnet/)
bin/
obj/
.vs/
*.user
TestResults/

# Expo (mobile/)
node_modules/
.expo/
dist/
web-build/

# Python e ML (ml/)
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
# Os CSV brutos do SP156 passam de 100 MB: ficam fora. O filtrado (poucos MB) entra.
ml/dados/brutos/
ml/dados/*.csv
!ml/dados/psiu_filtrado.csv

# Pacotes gerados para a VM (api-dotnet/scripts/empacotar-vm.ps1)

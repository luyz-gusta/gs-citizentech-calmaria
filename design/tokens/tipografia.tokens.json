{
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": {
        "$value": [
          "Atkinson Hyperlegible Next",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 22,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "2xl": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "3xl": {
        "$value": {
          "value": 36,
          "unit": "px"
        }
      },
      "4xl": {
        "$value": {
          "value": 44,
          "unit": "px"
        }
      },
      "5xl": {
        "$value": {
          "value": 52,
          "unit": "px"
        }
      }
    },
    "line-height": {
      "$type": "dimension",
      "$description": "Altura de linha em px, alinhada à grade.",
      "xs": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 28,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "2xl": {
        "$value": {
          "value": 40,
          "unit": "px"
        }
      },
      "3xl": {
        "$value": {
          "value": 44,
          "unit": "px"
        }
      },
      "4xl": {
        "$value": {
          "value": 52,
          "unit": "px"
        }
      },
      "5xl": {
        "$value": {
          "value": 60,
          "unit": "px"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    }
  },
  "typography": {
    "$type": "typography",
    "caption": {
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.4286,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "label-sm": {
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": 1.4286,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },

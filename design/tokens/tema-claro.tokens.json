{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{palette.neutral.100}",
        "$description": "Fundo da página."
      },
      "surface": {
        "$value": "{palette.neutral.50}",
        "$description": "Cartões, painéis, tabelas."
      },
      "raised": {
        "$value": "{palette.neutral.50}",
        "$description": "Menus, popovers, diálogos (com sombra)."
      },
      "subtle": {
        "$value": "{palette.neutral.200}",
        "$description": "Áreas rebaixadas, cabeçalho de tabela, hover de linha. text.subtle NÃO vai sobre ele."
      },
      "inverse": {
        "$value": "{palette.neutral.900}",
        "$description": "Tooltip, snackbar."
      },
      "overlay": {
        "$value": "{palette.scrim}",
        "$description": "Véu atrás de modal e gaveta."
      }
    },
    "text": {
      "default": {
        "$value": "{palette.neutral.900}",
        "$description": "Texto principal."
      },
      "muted": {
        "$value": "{palette.neutral.600}",
        "$description": "Texto secundário, rótulos de apoio."
      },
      "subtle": {
        "$value": "{palette.neutral.600}",
        "$description": "Terciário, placeholder, ajuda. Só sobre canvas, surface e raised."
      },
      "disabled": {
        "$value": "{palette.neutral.400}",
        "$description": "Controle desabilitado (isento de contraste pelo WCAG)."
      },
      "inverse": {
        "$value": "{palette.white}",
        "$description": "Texto sobre bg.inverse."
      },
      "link": {
        "$value": "{palette.brand.700}",
        "$description": "Link em texto corrido; sublinhe, não dependa só da cor."
      }
    },
    "border": {
      "default": {
        "$value": "{palette.neutral.200}",
        "$description": "Divisores e contornos decorativos."
      },
      "strong": {
        "$value": "{palette.neutral.500}",
        "$description": "Borda que identifica controle (input, checkbox): precisa de 3:1."
      },
      "focus": {
        "$value": "{palette.brand.600}",
        "$description": "Anel de foco (2px, com afastamento de 2px)."
      }
    },
    "primary": {
      "solid": {
        "$value": "{palette.brand.exact}",
        "$description": "Fundo do botão primário: a cor exata da marca (#3D5A73), 7,22:1 com branco."
      },
      "solid-hover": {
        "$value": "{palette.brand.exact-hover}"
      },
      "solid-pressed": {
        "$value": "{palette.brand.exact-pressed}"
      },
      "on-solid": {
        "$value": "{palette.white}",
        "$description": "Texto e ícone sobre primary.solid e seus estados."
      },
      "subtle": {
        "$value": "{palette.brand.100}",
        "$description": "Item selecionado, destaque suave. O passo 50 quase não se distingue do fundo nem do hover neutro."
      },
      "subtle-hover": {
        "$value": "{palette.brand.200}"
      },
      "text": {
        "$value": "{palette.brand.700}",
        "$description": "Texto e ícone na cor da marca sobre fundos claros."
      },
      "border": {
        "$value": "{palette.brand.600}",
        "$description": "Contorno de item selecionado, botão secundário."
      }
    },
    "success": {
      "solid": {
        "$value": "{palette.calmo.600}"

      "bg": {
        "$value": "{palette.brand.950}",
        "$description": "Fundo da tela de crise, igual nos dois temas."
      },
      "surface": {
        "$value": "{palette.brand.900}",
        "$description": "Cartão do refúgio na tela de crise."
      },

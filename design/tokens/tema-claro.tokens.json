      "on-solid": {
        "$value": "{palette.neutral.950}"
      },
      "subtle": {
        "$value": "{palette.moderado.50}"
      },
      "text": {
        "$value": "{palette.moderado.700}"
      },
      "icon": {
        "$value": "{palette.moderado.600}"
      },
      "border": {
        "$value": "{palette.moderado.200}"
      }

      "bg": {
        "$value": "{palette.brand.900}",
        "$description": "Botão de crise flutuante, sempre no mesmo canto."
      },
      "text": {
        "$value": "{palette.white}",
        "$description": "Rótulo e ícone do botão de crise."
      }

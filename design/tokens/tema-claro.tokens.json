        "solid": {
          "$value": "{palette.moderado.400}",
          "$description": "Preenchimento do selo e do marcador do nível."
        },
        "on-solid": {
          "$value": "{palette.neutral.950}",
          "$description": "Letra e texto sobre o preenchimento."
        },
        "subtle": {
          "$value": "{palette.moderado.100}",
          "$description": "Fundo do cartão do nível."
        },
        "text": {
          "$value": "{palette.moderado.700}",
          "$description": "Nome do nível escrito em texto e ícone."
        },
        "border": {
          "$value": "{palette.moderado.700}",
          "$description": "Contorno de 2px do marcador no mapa (3:1 contra o fundo)."
        }
      },
      "intenso": {
        "solid": {
          "$value": "{palette.intenso.600}",
          "$description": "Preenchimento do selo e do marcador do nível."
        },
        "on-solid": {
          "$value": "{palette.white}",
          "$description": "Letra e texto sobre o preenchimento."
        },
        "subtle": {
          "$value": "{palette.intenso.100}",
          "$description": "Fundo do cartão do nível."
        },
        "text": {
          "$value": "{palette.intenso.700}",
          "$description": "Nome do nível escrito em texto e ícone."
        },
        "border": {
          "$value": "{palette.intenso.700}",
          "$description": "Contorno de 2px do marcador no mapa (3:1 contra o fundo)."
        }
      }

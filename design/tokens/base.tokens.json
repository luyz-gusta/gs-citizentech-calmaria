  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ],
      "$description": "Movimento dentro da tela (Material 3 standard)."
    },
    "enter": {
      "$value": [
        0,
        0,
        0,
        1
      ],
      "$description": "Elemento entrando: desacelera até parar."
    },
    "exit": {
      "$value": [
        0.3,
        0,
        1,
        1
      ],
      "$description": "Elemento saindo: acelera para fora."
    }
  },
  "z-index": {
    "$type": "number",
    "$description": "Popover acima do modal: um select aberto dentro do diálogo precisa aparecer. Nada de 9999; <dialog> e a API popover vão para a top layer.",

  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 0,
        "unit": "ms"
      },
      "$description": "Hover, troca de cor, micro feedback."
    },
    "base": {
      "$value": {
        "value": 0,
        "unit": "ms"
      },
      "$description": "Abrir menu, tooltip, expandir item."
    },
    "slow": {

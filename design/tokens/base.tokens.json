        "value": 0,
        "unit": "ms"
      },
      "$description": "Modal, gaveta, transição de painel."
    },
    "slower": {
      "$value": {
        "value": 0,
        "unit": "ms"
      },
      "$description": "Transição de página ou de grande área; use pouco."

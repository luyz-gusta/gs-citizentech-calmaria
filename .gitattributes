# Quebra de linha igual para todos (Windows, Mac e Linux): LF no repositório e na cópia de trabalho.
* text=auto eol=lf

# Scripts do Windows ficam em CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary

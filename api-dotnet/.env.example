# Variáveis de ambiente da API Calmaria. O "__" faz o papel do ":" do appsettings.json.
# A API lê estas variáveis do ambiente, não deste arquivo. Para usar: copie para .env (que não vai para o Git),
# troque os valores entre < > e carregue no ambiente; na VM, o .env vira o EnvironmentFile do serviço systemd.
# Em desenvolvimento não precisa: a conexão fica no user-secrets, criada por
#   powershell -ExecutionPolicy Bypass -File api-dotnet/scripts/criar-banco-dev.ps1

# Banco PostgreSQL. A senha real fica só no .env ou no user-secrets, nunca no Git.
ConnectionStrings__Calmaria=Host=localhost;Port=5432;Database=calmaria;Username=calmaria;Password=<senha-do-usuario-calmaria>

# Endereço em que a API escuta.
ASPNETCORE_URLS=http://0.0.0.0:5080

# Chave das rotas administrativas (cabeçalho X-Admin-Key) e do painel /seguranca.
Privacidade__ChaveAdmin=<uma-chave-longa-e-aleatoria>

# true aplica as migrações ao subir. Fora do desenvolvimento, prefira o pacote de migrações (efbundle).
Banco__MigrarAoIniciar=false

# O consumidor MQTT das leituras do ESP32 (broker.hivemq.com).
Mqtt__Habilitado=true

# Opcional: o LLM dos alertas, com a API de chat no formato da OpenAI. Vazio, o alerta usa a frase pronta.
Llm__UrlBase=
Llm__Modelo=
Llm__Chave=
